# Copy to .env and fill in real values. NEVER commit .env.

# --- WhatsApp transport (Task 0B) ---
# Random string you choose; must match the value entered in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=pick-a-long-random-string
# From Meta App Dashboard > Settings > Basic. Required to validate live events.
WHATSAPP_APP_SECRET=
# From Meta for Developers > WhatsApp > API Setup (test number works).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required when both values above are set: copy the supported version from Meta's API Setup.
WHATSAPP_GRAPH_API_VERSION=

# --- ElevenLabs voice webhook tool ---
# Set this as a Secret custom header named X-Voice-Webhook-Secret in ElevenLabs.
ELEVENLABS_WEBHOOK_SECRET=

# --- LLM provider (Task 1+) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
# A stored key does nothing until this is explicitly enabled for a controlled test.
LLM_ENABLED=false
# Keep false for the first live test: use one configured model, predictable cost.
LLM_ROUTING_ENABLED=false

# --- Google Sheets CRM (Task 5) ---
# Paste the complete service-account JSON as one environment value in Vercel.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
